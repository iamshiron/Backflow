                                    "name",
                                    "direction",
                                    "clrType",
                                    "schema",
                                    "required",
                                    "minimumCount",
                                    "maximumCount"
                                ]
                            }
                        },
                        "isExecutable": {
                            "type": "boolean"
                        },
                        "configurationSchema": {
                            "default": null
                        }
                    },
                    "required": ["id", "ports", "isExecutable"]
                }
            }
        },
        "required": ["nodes"]
    },
