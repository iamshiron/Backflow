{
    "$schema": "./node_modules/nx/schemas/nx-schema.json",
    "targetDefaults": {
        "build": { "dependsOn": ["^build"] },
        "typecheck": { "dependsOn": ["^build"] }
    },
    "plugins": [
        {
            "plugin": "@nx/js/typescript",
            "options": {
                "typecheck": { "targetName": "typecheck" },
                "build": {
                    "targetName": "build",
                    "configName": "tsconfig.lib.json"
                }
            }
        }
    ],
    "neverConnectToCloud": true,
    "analytics": false
}
