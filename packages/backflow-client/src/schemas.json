                                    "direction": {
                                        "type": "integer"
                                    },
                                    "clrType": {
                                        "type": "string"
                                    },
                                    "schema": true,
                                    "required": {
                                        "type": "boolean"
                                    },
                                    "minimumCount": {
                                        "type": ["string", "integer", "null"],
                                        "pattern": "^-?(?:0|[1-9]\\d*)$"
                                    },
                                    "maximumCount": {
                                        "type": ["string", "integer", "null"],
                                        "pattern": "^-?(?:0|[1-9]\\d*)$"
                                    }
